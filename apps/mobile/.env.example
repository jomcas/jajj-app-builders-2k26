# Copy to .env.local (git-ignored) and fill in, or run scripts/dev-setup.sh to write it for the
# local Supabase stack. Use the anon/publishable key only, never the service_role or secret key.
# For a local stack, use this machine's LAN IP (not localhost): the phone has to reach it.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
